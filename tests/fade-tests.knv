(use fade ->edge-fade ->fade ->image-size ->percent
          ->pixel-row row-brightness)

(def tolerance 0.000001)

(def eleven-row-image (->image-size :height 11))

(defn brightness (top bottom pixel-row)
  (row-brightness (->fade :top top :bottom bottom)
                  eleven-row-image pixel-row))

(defn edge (darkening reach)
  (->edge-fade :darkening (->percent :value darkening)
               :reach (->percent :value reach)))

(defn about? (actual expected)
  (< (- expected tolerance) actual (+ expected tolerance)))

(deftest the-top-row-is-darkened-by-the-top-darkening
  (assert (about? (brightness (edge 40 30)
                              (edge 0 0)
                              (->pixel-row :index 0))
                  0.6)))

(deftest a-row-halfway-into-the-top-reach-gets-half-the-darkening
  (assert (about? (brightness (edge 40 40)
                              (edge 0 0)
                              (->pixel-row :index 2))
                  0.8)))

(deftest a-row-past-the-top-reach-keeps-its-brightness
  (assert (about? (brightness (edge 40 30)
                              (edge 0 0)
                              (->pixel-row :index 5))
                  1.0)))

(deftest the-last-row-is-darkened-by-the-bottom-darkening
  (assert (about? (brightness (edge 0 0)
                              (edge 50 50)
                              (->pixel-row :index 10))
                  0.5)))

(deftest a-zero-reach-leaves-the-edge-untouched
  (assert (about? (brightness (edge 40 0)
                              (edge 0 0)
                              (->pixel-row :index 0))
                  1.0)))
