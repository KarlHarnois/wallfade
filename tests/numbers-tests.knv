(use numbers abs-difference float->u8 int->float u8->int)

(deftest an-int-becomes-the-same-float
  (assert (= (int->float 40) 40.0)))

(deftest a-byte-becomes-the-same-int
  (assert (= (u8->int (the u8 200)) 200)))

(deftest the-difference-ignores-which-number-is-larger
  (assert (= (abs-difference 3 10) (abs-difference 10 3) 7)))

(deftest a-float-rounds-to-the-nearest-byte
  (assert (= (float->u8 99.6) (the u8 100))))
