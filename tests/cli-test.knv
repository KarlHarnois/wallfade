(use knave-commandant ->environment parse-args-from)
(use cli matches->wallfade wallfade-spec)

(defn output (texts)
  (-> texts wallfade-cli
      (map-ok (fn (cmd) (clone (:output cmd))))))

(defn input (texts)
  (-> texts wallfade-cli
      (map-ok (fn (cmd) (clone (:input cmd))))))

(defn wallfade-cli (texts)
  (parse-args-from wallfade (empty-env) (words texts)))

(defn empty-env ()
  (->environment :variables (vec)))

(defn words (texts)
  (-> texts (map str) collect))

(deftest the-input-is-the-first-argument
  (assert (= (input (vec "wall.jpg"))
             (ok (str "wall.jpg")))))

(deftest the-output-is-absent-without-the-option
  (assert (= (output (vec "wall.jpg")) (ok none))))

(deftest the-short-option-sets-the-output
  (assert (= (output (vec "wall.jpg" "-o" "out.png"))
             (ok (some (str "out.png"))))))
