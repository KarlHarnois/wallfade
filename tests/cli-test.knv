(use knave-commandant ->environment parse-args-from)
(use cli matches->wallfade wallfade-spec)

(defn output-after (texts)
  (map-ok (wallfade-after texts)
    (fn (command) (clone (:output command)))))

(defn exit-code-after (texts)
  (:code (unwrap-err (wallfade-after texts))))

(defn wallfade-after (texts)
  (parse-args-from wallfade
                   (->environment :variables (vec))
                   (words texts)))

(defn words (texts)
  (collect (map (iter texts)
             (fn (text) (str (deref text))))))

(deftest the-input-is-the-first-argument
  (assert (= (map-ok (wallfade-after (vec "wall.jpg"))
               (fn (command) (clone (:input command))))
             (ok (str "wall.jpg")))))

(deftest the-output-is-absent-without-the-option
  (assert (= (output-after (vec "wall.jpg"))
             (ok none))))

(deftest the-short-option-sets-the-output
  (assert (= (output-after (vec "wall.jpg" "-o" "out.png"))
             (ok (some (str "out.png"))))))

(deftest the-long-option-sets-the-output
  (assert (= (output-after (vec "--output" "out.png" "wall.jpg"))
             (ok (some (str "out.png"))))))

(deftest a-missing-input-is-a-usage-error
  (assert (= (exit-code-after (the (vec (ref str)) (vec)))
             2)))

(deftest an-unknown-option-is-a-usage-error
  (assert (= (exit-code-after (vec "wall.jpg" "--top" "40")) 2)))
