(use images ->image bytes-per-pixel)
(use numbers float->u8 int->float u8->int)

(export ->edge-fade ->fade ->percent ->pixel-row edge-fade
        edge-fade-of fade faded-image percent pixel-row
        row-brightness)

(defstruct fade
  :top edge-fade
  :bottom edge-fade)

(defstruct edge-fade
  :darkening percent
  :reach percent)

(defstruct percent
  :value int)

(defstruct pixel-row
  :index int)

(defn faded-image (fade image)
  (let (row-length (-> image :size :width (* bytes-per-pixel))
        brightness-by-row (brightness-by-row (ref fade) (:size image))
        fade-byte (fn (indexed-byte)
                    (faded-byte (ref brightness-by-row)
                                row-length indexed-byte))
        bytes (-> (:bytes image) enumerate (map fade-byte) collect))
    (assoc image :bytes bytes)))

(defn edge-fade-of (darkening reach)
  (->edge-fade :darkening (->percent :value darkening)
               :reach (->percent :value reach)))

(defn row-brightness (fade image-size pixel-row)
  (let (index (-> pixel-row :index int->float)
        last-index (-> image-size :height dec (max 1) int->float)
        distance-from-top (/ index last-index)
        distance-from-bottom (- 1.0 distance-from-top))
    (* (edge-brightness (:top fade) distance-from-top)
       (edge-brightness (:bottom fade) distance-from-bottom))))

(defn brightness-by-row (fade size)
  (-> (range 0 (:height size))
      (map (fn (index)
             (row-brightness fade size (->pixel-row :index index))))
      collect))

(defn faded-byte (brightness-by-row row-length indexed-byte)
  (let-match ((pair index byte) indexed-byte)
    (let (row-index (/ index row-length)
          brightness (-> brightness-by-row (at row-index) deref)
          value (-> byte deref u8->int int->float))
      (float->u8 (* value brightness)))))

(defn edge-brightness (edge-fade distance-from-edge)
  (let (darkening (-> edge-fade :darkening fraction)
        reach (-> edge-fade :reach fraction))
    (->> (share-of-darkening distance-from-edge reach)
         (* darkening)
         (- 1.0))))

(defn share-of-darkening (distance-from-edge reach)
  (if (>= distance-from-edge reach)
    0.0
    (- 1.0 (/ distance-from-edge reach))))

(defn fraction (percent)
  (-> percent :value int->float (/ 100.0)))
