(use knave-commandant parse-args)
(use cli matches->wallfade wallfade-spec)
(use fade ->edge-fade ->fade ->percent faded-image)
(use image-file error->message read-image write-image)
(use output-path output-path)

(defn main ()
  (let (args (parse-args wallfade)
        input (:input args)
        output (output-path (as-str input)
                            (clone (:output args))))
    (match (fade-wallpaper (default-fade)
                           (as-str input)
                           (as-str output))
      ((ok written) (println written))
      ((err failure) (eprintln (error->message failure)) (exit 1)))))

(defn default-fade ()
  (->fade :top (edge-fade 40 30) :bottom (edge-fade 35 40)))

(defn edge-fade (darkening reach)
  (->edge-fade :darkening (->percent :value darkening)
               :reach (->percent :value reach)))

(defn fade-wallpaper (fade input output)
  (let (image (try (read-image input))
        faded (faded-image fade image))
    (-> (write-image (ref faded) output)
        (map-ok (fn (_) (str output))))))
